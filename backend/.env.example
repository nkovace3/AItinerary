# Copy this file to .env and fill in real values. .env is gitignored — .env.example is not.

GOOGLE_API_KEY=
TAVILY_API_KEY=

# Matches the default credentials/db name in ../docker-compose.yml.
# If you change POSTGRES_USER/PASSWORD/DB there, update this to match.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interms
